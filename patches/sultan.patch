+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 19, 0)
+    #define nm_inode_is_new(inode) (inode_state_read_once(inode) & I_NEW)
+#else
+    #define nm_inode_is_new(inode) (inode->i_state & I_NEW)
+#endif

+    u16 r_len;
+} __attribute__((packed));
+
+struct nm_del_hdr {
+    u32 uid;
+    u32 uid_end;
+    u32 deny_start;
+    u32 deny_end;
+    u16 v_len;
+} __attribute__((packed));

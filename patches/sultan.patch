+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(5, 12, 0)
+    #define IDMAP_PATH(path) mnt_user_ns((path).mnt),
+    #define IDMAP_ARG struct user_namespace *mnt_userns,
+    #define IDMAP_CALL mnt_userns,
+#else
+    #define IDMAP_PATH(path)/* Nothing */

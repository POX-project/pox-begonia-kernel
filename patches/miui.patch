--- /dev/null
+++ b/arch/arm64/configs/miui.config
@@ -0,0 +1,13 @@
+# MIUI / HyperOS vendor WLAN compatibility
+#
+# These match the onyx-miui branch:
+#   - vendor wlan_drv_gen4m can half-load when BUG_ON_DATA_CORRUPTION is on;
+#   - unprivileged BPF default-off can leave system_server in a boot loop.
+# Keep them disabled for MIUI/HyperOS builds.
+# CONFIG_BPF_UNPRIV_DEFAULT_OFF is not set
+# CONFIG_BUG_ON_DATA_CORRUPTION is not set
+
+# Report the OEM configuration through /proc/config.gz. MIUI/HyperOS
+# userspace compares it with the stock configuration and warns when it
+# differs, so keep the customized build configuration hidden.
+CONFIG_IKCONFIG_STOCK_DEFCONFIG=y

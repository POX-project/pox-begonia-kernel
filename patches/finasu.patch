+kernelsu-objs += policy/app_profile.o
+kernelsu-objs += policy/feature.o
+
+kernelsu-objs += runtime/boot_event.o
+kernelsu-objs += runtime/ksud_integration.o
+
+kernelsu-objs += infra/btf_parser.o
+kernelsu-objs += selinux/inode.o
+kernelsu-objs += selinux/selinux.o
+kernelsu-objs += selinux/rules.o
+kernelsu-objs += selinux/sepolicy.o
+
+kernelsu-objs += sulog/event.o
+kernelsu-objs += sulog/fd.o
+
+kernelsu-objs += supercall/dispatch.o
+kernelsu-objs += supercall/perm.o
+kernelsu-objs += supercall/supercall.o
+
+kernelsu-objs += feature/adb_root.o
+
+kernelsu-objs += feature/selinux_hide.o
+kernelsu-objs += feature/shell_su_adb_only.o
+kernelsu-objs += feature/avc_spoof.o
+kernelsu-objs += feature/mount_view_filter.o
+
+kernelsu-$(CONFIG_KSU_SUSFS) += extension/susfs.o
+
+ifdef KBUILD_EXTMOD
+ifeq ($(CONFIG_KSU_DISABLE_MANAGER),y)
+ccflags-y += -DCONFIG_KSU_DISABLE_MANAGER=1
+endif
+ifneq ($(CONFIG_KSU_DYNAMIC_MANAGER),n)
+ccflags-y += -DCONFIG_KSU_DYNAMIC_MANAGER=1
+endif
+ifeq ($(CONFIG_KSU_DISABLE_POLICY),y)
+ccflags-y += -DCONFIG_KSU_DISABLE_POLICY=1
+endif
+ifeq ($(CONFIG_KSU_DEBUG),y)
+ccflags-y += -DCONFIG_KSU_DEBUG=1
+endif
+ifeq ($(CONFIG_KSU_X86_PATCH_SYSCALL_DISPATCHER),y)
+ccflags-y += -DCONFIG_KSU_X86_PATCH_SYSCALL_DISPATCHER=1
+endif
+endif
+
+ccflags-y += -I$(srctree)/security/selinux -I$(srctree)/security/selinux/include
+ccflags-y += -I$(objtree)/security/selinux -include $(srctree)/include/uapi/asm-generic/errno.h
+
+ifneq ($(KBUILD_EXTMOD),)
+# 6.18 exports the external module source as srcroot when M/MO are used.
+ifneq ($(srcroot),)
+KSU_KERNEL_DIR := $(srcroot)
+endif
+endif
+ifndef KSU_KERNEL_DIR
+ifeq ($(filter /%,$(src)),)
+KSU_KERNEL_DIR := $(srctree)/$(src)
+else
+KSU_KERNEL_DIR := $(src)
+endif
+endif
+
+ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include
+
+ifdef CONFIG_KSU_HOOK_SUSFS_INLINE
+ifneq ($(CONFIG_KSU_SUSFS),y)
+$(error SUSFS Inline requires CONFIG_KSU_SUSFS=y)
+endif
+ifdef KBUILD_EXTMOD
+$(error SUSFS Inline does not support LKM builds)
+endif
+SUSFS_INLINE_CHECK_RESULT := $(shell $(KSU_KERNEL_DIR)/tools/check_susfs_inline.sh "$(srctree)"; echo $$?)
+ifeq ($(lastword $(SUSFS_INLINE_CHECK_RESULT)),0)
+else
+$(error SUSFS Inline hook-site check failed)
+endif
+endif
+
+KSU_UAPI_INC := $(objtree)/usr/include
+ifneq ($(wildcard $(KSU_UAPI_INC)/linux/unistd.h),)
+kernelsu-objs += preinit/preinit.o
+kernelsu-objs += preinit/blob.o
+
+KSU_RUNNER_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall \
+	-nostdinc -isystem $(shell $(CC) -print-file-name=include) \
+	-I$(KSU_KERNEL_DIR)/preinit/runner/nolibc -I$(KSU_UAPI_INC) \
+	-I$(KSU_KERNEL_DIR)/include \
+	-ffreestanding -fno-stack-protector -fno-pic -fno-pie \
+	-fno-asynchronous-unwind-tables -fno-unwind-tables \
+	-ffunction-sections -fdata-sections
+
+quiet_cmd_ksu_runner = RUNNER  $@
+      cmd_ksu_runner = $(CC) $(KSU_RUNNER_CFLAGS) -c -o $@.o $< && \
+		$(LD) -static -nostdlib -e _start --gc-sections -s -o $@ $@.o && \
+		rm -f $@.o
+
+$(obj)/preinit/runner.elf: $(KSU_KERNEL_DIR)/preinit/runner/runner.c \
+		$(wildcard $(KSU_KERNEL_DIR)/preinit/runner/nolibc/*.h \
+			   $(KSU_KERNEL_DIR)/preinit/runner/nolibc/sys/*.h \
+			   $(KSU_KERNEL_DIR)/include/uapi/*.h) FORCE
+	$(call if_changed,ksu_runner)
+
+targets += preinit/runner.elf
+$(obj)/preinit/blob.o: $(obj)/preinit/runner.elf
+asflags-y += -DKSU_PREINIT_RUNNER_BIN=\"$(obj)/preinit/runner.elf\"
+else
+ifeq ($(KSU_REQUIRE_PREINIT),1)
+$(error Target UAPI headers missing at $(KSU_UAPI_INC); preinit runner is required)
+endif
+$(warning Target UAPI headers missing at $(KSU_UAPI_INC); preinit disabled)
+ccflags-y += -DKSU_NO_PREINIT
+endif
+
+obj-$(CONFIG_KSU) += kernelsu.o
+
+MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
+
+# Workaround bazel
+# https://github.com/tiann/KernelSU/pull/316#issuecomment-1479043219
+GIT := $(shell PATH="$$PATH":/usr/bin:/usr/local/bin which git)
+ifneq ($(GIT),)
+# Check if this is a git repository
+# Try to detect Git repo intelligently
+GIT_ROOT := $(shell cd $(MDIR) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
+ifneq ($(GIT_ROOT),)
+KERNEL_GIT_ROOT := $(shell cd $(srctree) && $(GIT) rev-parse --show-toplevel 2>/dev/null)
+ifneq ($(GIT_ROOT),$(KERNEL_GIT_ROOT))
+# Only set version if it's a different repo from kernel
+$(shell cd $(GIT_ROOT) && [ -f .git/shallow ] && $(GIT) fetch --unshallow 2>/dev/null || true)
+KSU_GIT_VERSION := $(shell cd $(GIT_ROOT) && $(GIT) rev-list --count HEAD 2>/dev/null)
+KSU_GIT_VERSION_VALID := 1
+$(info -- KernelSU: Git repo detected at $(GIT_ROOT))
+endif
+endif
+else
+$(warning -- KernelSU: Git not detected, make sure git is installed in your PATH!)
+endif
+
+
+# Calculate version if git version is available
+ifdef KSU_GIT_VERSION_VALID
+# ksu_version: major * 10000 + git version + 200 for historical reasons
+$(eval KSU_VERSION=$(shell expr 30000 + $(KSU_GIT_VERSION)))
+$(info -- KernelSU version: $(KSU_VERSION))
+ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
+KSU_VERSION_TAG := $(shell cd $(GIT_ROOT) && $(GIT) describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
+KSU_VERSION_SHA := $(shell cd $(GIT_ROOT) && $(GIT) rev-parse --short=8 HEAD 2>/dev/null)
+KSU_VERSION_BRANCH := $(shell cd $(GIT_ROOT) && $(GIT) rev-parse --abbrev-ref HEAD 2>/dev/null)
+KSU_VERSION_FULL := v$(if $(KSU_VERSION_TAG),$(KSU_VERSION_TAG),unknown)-$(KSU_VERSION_SHA)@$(KSU_VERSION_BRANCH)
+else
+# If there is no .git directory, use default version
+$(warning "KSU_GIT_VERSION not defined! It is better to make KernelSU a git repository!")
+ccflags-y += -DKSU_VERSION=16
+KSU_VERSION_FULL := v0.0.0-00000000@unknown
+endif
+
+$(info -- KernelSU version full: $(KSU_VERSION_FULL))
+ccflags-y += -DKSU_VERSION_FULL=\"$(KSU_VERSION_FULL)\"
+
+KSU_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
+$(info -- KSU_NEW_DCACHE_FLUSH: $(KSU_NEW_DCACHE_FLUSH))
+
+
+ifndef KSU_EXPECTED_SIZE
+KSU_EXPECTED_SIZE := 0x2cc
+endif
+
+ifndef KSU_EXPECTED_HASH
+KSU_EXPECTED_HASH := 2d89b50aaf1db013c2b6738f973f48b62ea21a3a8d7216bfec3521065d448458
+endif
+
+ifdef KSU_MANAGER_PACKAGE
+ccflags-y += -DKSU_MANAGER_PACKAGE=\"$(KSU_MANAGER_PACKAGE)\"
+$(info -- KernelSU Manager package name: $(KSU_MANAGER_PACKAGE))
+endif
+
+$(info -- KernelSU Manager signature size: $(KSU_EXPECTED_SIZE))
+$(info -- KernelSU Manager signature hash: $(KSU_EXPECTED_HASH))
+
+ccflags-y += -DEXPECTED_SIZE=$(KSU_EXPECTED_SIZE)
+ccflags-y += -DEXPECTED_HASH=\"$(KSU_EXPECTED_HASH)\"
+
+ifdef KSU_EXPECTED_SIZE2
+ifndef KSU_EXPECTED_HASH2
+$(error KSU_EXPECTED_HASH2 must be set when KSU_EXPECTED_SIZE2 is set)
+endif
+ccflags-y += -DEXPECTED_SIZE2=$(KSU_EXPECTED_SIZE2)
+ccflags-y += -DEXPECTED_HASH2=\"$(KSU_EXPECTED_HASH2)\"
+# The second slot carries one extra trusted manager signature. Test builds fill it
+# with a throwaway key, which is why defining it also raises the PR-build flag; set
+# KSU_SECOND_SIGNATURE_RELEASE=1 when that slot holds a release key instead.
+ifeq ($(KSU_SECOND_SIGNATURE_RELEASE),1)
+ccflags-y += -DSECOND_SIGNATURE_RELEASE=1
+$(info -- KernelSU Manager second signature is a release key)
+endif
+$(info -- KernelSU Manager signature size2: $(KSU_EXPECTED_SIZE2))
+$(info -- KernelSU Manager signature hash2: $(KSU_EXPECTED_HASH2))
+endif
+
+# Trusted FinaSU manager slot: prefer slot2 when present, else slot1.
+ifndef FINASU_TRUSTED_SIZE
+ifdef KSU_EXPECTED_SIZE2
+FINASU_TRUSTED_SIZE := $(KSU_EXPECTED_SIZE2)
+FINASU_TRUSTED_HASH := $(KSU_EXPECTED_HASH2)
+endif
+endif
+ifndef FINASU_TRUSTED_SIZE
+FINASU_TRUSTED_SIZE := $(KSU_EXPECTED_SIZE)
+FINASU_TRUSTED_HASH := $(KSU_EXPECTED_HASH)
+endif
+ccflags-y += -DFINASU_TRUSTED_SIZE=$(FINASU_TRUSTED_SIZE)
+ccflags-y += -DFINASU_TRUSTED_HASH=\"$(FINASU_TRUSTED_HASH)\"
+
+# Recognition-only preset managers; bit mask selects which rows are compiled in.
+ifndef KSU_PRESET_MANAGER_MASK
+KSU_PRESET_MANAGER_MASK := 0xff
+endif
+ccflags-y += -DKSU_PRESET_MANAGER_MASK=$(KSU_PRESET_MANAGER_MASK)
+
+ccflags-y += -DKSU_NEW_DCACHE_FLUSH=$(KSU_NEW_DCACHE_FLUSH)
+
+ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
+ccflags-y += -Wno-declaration-after-statement -Wno-unused-function
+
+obj-$(CONFIG_KSU) += kernelsu.o
+
+# Keep a new line here!! Because someone may append config
diff --git a/drivers/finasu/Kconfig b/drivers/finasu/Kconfig
new file mode 100644
index 000000000000..0d76bdc3ced4
--- /dev/null
+++ b/drivers/finasu/Kconfig
@@ -0,0 +1,174 @@
+menu "KernelSU"
+
+config KSU
+	tristate "KernelSU function support"
+	depends on KPROBES && EXT4_FS
+	default y
+	help
+	  Enable kernel-level root privileges on Android System.
+	  Requires CONFIG_KPROBES for kernel hooking support.
+	  Requires CONFIG_EXT4_FS for `ext4_unregister_sysfs`.
+	  To compile as a module, choose M here: the
+	  module will be called kernelsu.
+
+choice
+	prompt "KernelSU syscall hook backend"
+	depends on KSU
+	default KSU_HOOK_TRACEPOINT
+	help
+	  Choose how KernelSU enters its syscall handlers. This choice is fixed at
+	  build time; the Manager does not switch it at runtime.
+
+config KSU_HOOK_TRACEPOINT
+	bool "Tracepoint"
+	depends on HAVE_SYSCALL_TRACEPOINTS
+	help
+	  Redirect selected syscalls through the sys_enter tracepoint and a shared
+	  dispatcher entry in sys_call_table. This is the default backend.
+
+config KSU_HOOK_SUSFS_INLINE
+	bool "SUSFS Inline"
+	depends on ARM64 && KSU=y && KSU_SUSFS
+	help
+	  Use the direct KSU entry points supplied by the pinned SUSFS kernel patch.
+	  This backend is built into the kernel and does not register the generic
+	  sys_enter tracepoint, dispatcher, or replaced kprobes.
+
+endchoice
+
+config KSU_DEBUG
+	bool "KernelSU debug mode"
+	depends on KSU
+	default n
+	help
+	  Enable KernelSU debug mode.
+
+config KSU_DISABLE_MANAGER
+	bool "Disable KernelSU manager integration"
+	depends on KSU
+	default n
+	help
+	  Disable manager APK detection and manager-specific handling.
+	  Root will be used in place of manager-only functionality.
+
+config KSU_DYNAMIC_MANAGER
+	bool "Enable KernelSU dynamic manager support"
+	depends on KSU && !KSU_DISABLE_MANAGER
+	default y
+	help
+	  Track manager candidates discovered by signature verification and let
+	  the user explicitly authorize them as dynamic managers. Preset
+	  signatures are recognized but never authorized automatically.
+
+config KSU_DISABLE_POLICY
+	bool "Disable KernelSU policy profiles"
+	depends on KSU
+	default n
+	help
+	  Disable per-app root/non-root profile customization.
+	  Escalation will always use the default full root profile, and
+	  non-root handling will follow the global umount policy only.
+
+config KSU_X86_PATCH_SYSCALL_DISPATCHER
+	bool "Dynamically patch x64's hardened syscall dispatcher to support syscall hooks"
+	depends on KSU && X86_64
+	default n
+	help
+	  Dynamically patch x64's hardened syscall dispatcher to support syscall hooks. This is a
+	  replacement for a kernel source code patch, and is useful for x86_64 LKM mode.
+
+menu "KernelSU - SUSFS"
+config KSU_SUSFS
+	bool "KernelSU addon - SUSFS"
+	depends on KSU=y
+	depends on THREAD_INFO_IN_TASK
+	default n
+	help
+	  Compile the KernelSU side of the SUSFS interface. The SUSFS kernel
+	  implementation still has to be applied to the kernel tree, and
+	  KernelSU has to be built in rather than loaded as a module.
+
+config KSU_SUSFS_SUS_PATH
+	bool "Enable to hide suspicious path"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Hide a user-defined path and everything below it from the system calls
+	  SUSFS intercepts. Prefer add_sus_path_loop for paths that change often.
+	  Only applies to app processes spawned from zygote that carry the
+	  TIF_PROC_UMOUNTED mark. Costs performance and is not immune to
+	  side-channel probing.
+
+config KSU_SUSFS_SUS_MOUNT
+	bool "Enable to hide suspicious mounts"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Give mounts created by the su process fake mount ids until /sdcard is
+	  decrypted, and hide SUSFS mounts from /proc/self/[mounts|mountinfo|mountstat]
+	  for non-su processes. Only applies to app processes spawned from zygote
+	  that carry the TIF_PROC_UMOUNTED mark.
+
+config KSU_SUSFS_SUS_KSTAT
+	bool "Enable to spoof suspicious kstat"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Report spoofed stat data for user-defined paths. Applies to processes
+	  whose uid modulo 100000 is at least 10000.
+
+config KSU_SUSFS_SPOOF_UNAME
+	bool "Enable to spoof uname"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Return a user-defined string from uname. Applies to all processes.
+
+config KSU_SUSFS_ENABLE_LOG
+	bool "Enable logging susfs log to kernel"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Write SUSFS diagnostics to the kernel log. Disable to silence all
+	  SUSFS logging.
+
+config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	bool "Enable to automatically hide ksu and susfs symbols from /proc/kallsyms"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Hide KernelSU and SUSFS symbols from /proc/kallsyms for all processes.
+
+config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	bool "Enable to spoof /proc/bootconfig (gki) or /proc/cmdline (non-gki)"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Replace /proc/bootconfig on GKI kernels, or /proc/cmdline on non-GKI
+	  kernels, with the contents of a user-defined file. Applies to all
+	  processes.
+
+config KSU_SUSFS_OPEN_REDIRECT
+	bool "Enable to redirect a path to be opened with another path"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Open a user-defined path in place of another one. Both paths must exist
+	  when the rule is added, and SELinux permissions for both sides remain
+	  the caller's responsibility. Only applies to processes using the
+	  predefined uid scheme.
+
+config KSU_SUSFS_SUS_MAP
+	bool "Enable to hide some mmapped real file from different proc maps interfaces"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Hide the backing file of mmapped regions from
+	  /proc/<pid>/[maps|smaps|smaps_rollup|map_files|mem|pagemap]. Anonymous
+	  mappings are not covered, and hooks placed by the injected library
+	  itself are not hidden. Only applies to zygote-spawned app processes
+	  that carry the TIF_PROC_UMOUNTED mark.
+
+endmenu
+
+endmenu

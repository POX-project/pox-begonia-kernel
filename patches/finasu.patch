diff --git a/drivers/finasu/include/util.h b/drivers/finasu/include/util.h
new file mode 100644
index 000000000000..afa6f6d3a302
--- /dev/null
+++ b/drivers/finasu/include/util.h
@@ -0,0 +1,90 @@
+#ifndef __KSU_H_UTIL
+#define __KSU_H_UTIL
+
+#include "linux/fdtable.h" // IWYU pragma: keep
+#include <linux/version.h>
+#include <linux/syscalls.h>
+#include <linux/namei.h>
+#include <linux/fs.h>
+#include <linux/err.h>
+#include <linux/cred.h>
+#include <linux/ptrace.h>
+#include <linux/uaccess.h>
+
+#include "arch.h"
+
+#if defined(__aarch64__)
+#define KSU_SYS_PREFIX(name) __arm64_sys_##name
+#elif defined(__x86_64__)
+#define KSU_SYS_PREFIX(name) __x64_sys_##name
+#elif defined(__riscv)
+#define KSU_SYS_PREFIX(name) __riscv_sys_##name
+#else // wire up your arch here.
+static_assert(1 == 0, "Unsupported architecture!");
+#define KSU_SYS_PREFIX(name) sys_##name
+#endif
+
+/**
+ * ksyscall: call syscalls from kernelspace
+ * - tries to copy unistd's syscall()
+ *
+ * usage: ksyscall(close, fd);
+ */
+#define __ksyscall(name, a, b, c, d, e, f)                                                                             \
+    ({                                                                                                                 \
+        extern long KSU_SYS_PREFIX(name)(const struct pt_regs *);                                                      \
+        struct pt_regs __ksu_regs = { 0 };                                                                             \
+        PT_REGS_SYSCALL_PARM1(&__ksu_regs) = (unsigned long)(a);                                                       \
+        PT_REGS_PARM2(&__ksu_regs) = (unsigned long)(b);                                                               \
+        PT_REGS_PARM3(&__ksu_regs) = (unsigned long)(c);                                                               \
+        PT_REGS_SYSCALL_PARM4(&__ksu_regs) = (unsigned long)(d);                                                       \
+        PT_REGS_PARM5(&__ksu_regs) = (unsigned long)(e);                                                               \
+        PT_REGS_PARM6(&__ksu_regs) = (unsigned long)(f);                                                               \
+        (long)KSU_SYS_PREFIX(name)(&__ksu_regs);                                                                       \
+    })
+
+// https://elixir.bootlin.com/musl/v1.2.6/source/src/internal/syscall.h#L45
+#define ksyscall_0(name) __ksyscall(name, 0, 0, 0, 0, 0, 0)
+#define ksyscall_1(name, a) __ksyscall(name, a, 0, 0, 0, 0, 0)
+#define ksyscall_2(name, a, b) __ksyscall(name, a, b, 0, 0, 0, 0)
+#define ksyscall_3(name, a, b, c) __ksyscall(name, a, b, c, 0, 0, 0)
+#define ksyscall_4(name, a, b, c, d) __ksyscall(name, a, b, c, d, 0, 0)
+#define ksyscall_5(name, a, b, c, d, e) __ksyscall(name, a, b, c, d, e, 0)
+#define ksyscall_6(name, a, b, c, d, e, f) __ksyscall(name, a, b, c, d, e, f)
+
+#define __ksyscall_arg_n(_1, _2, _3, _4, _5, _6, _7, N, ...) N
+#define __ksyscall_count_args(...) __ksyscall_arg_n(__VA_ARGS__, 6, 5, 4, 3, 2, 1, 0)
+#define __ksyscall_concat(a, b) a##b
+#define __ksyscall_exp(func, arg) __ksyscall_concat(func, arg)
+#define ksyscall(...) __ksyscall_exp(ksyscall_, __ksyscall_count_args(__VA_ARGS__))(__VA_ARGS__)
+
+static inline void __user *userspace_stack_buffer(const void *d, size_t len)
+{
+    char __user *p = (void __user *)current_user_stack_pointer() - len;
+
+    return copy_to_user(p, d, len) ? NULL : p;
+}
+
+#define ksu_close_fd(fd) ({ ksyscall(close, fd); })
+
+static inline struct file *ksu_filp_open_nonotify(const char *path, int flags)
+{
+    struct path p;
+    struct file *f;
+    int ret;
+    ret = kern_path(path, (flags & O_NOFOLLOW) ? 0 : LOOKUP_FOLLOW, &p);
+    if (ret) {
+        return ERR_PTR(ret);
+    }
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0)
+    f = dentry_open_nonotify(&p, flags, current_cred());
+#else
+    f = dentry_open(&p, flags | __FMODE_NONOTIFY, current_cred());
+#endif
+
+    path_put(&p);
+    return f;
+}
+
+#endif
diff --git a/drivers/finasu/infra/btf_parser.c b/drivers/finasu/infra/btf_parser.c
new file mode 100644
index 000000000000..b95926ff4584
--- /dev/null
+++ b/drivers/finasu/infra/btf_parser.c
@@ -0,0 +1,72 @@
+#include "infra/btf_parser.h"
+
+#if defined(MODULE) && defined(CONFIG_DEBUG_INFO_BTF)
+#include <linux/bpf.h>
+#include <linux/btf.h>
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+
+#include "klog.h"
+
+int ksu_btf_field(const char *structure, const char *member, u32 kind, u32 size, struct ksu_btf_field *field)
+{
+    const struct btf *btf;
+    const struct btf_type *type;
+    const struct btf_member *m;
+    s32 id;
+    u32 i;
+
+    pr_info("BTF: acquiring vmlinux metadata for %s.%s\n", structure, member);
+    btf = bpf_get_btf_vmlinux();
+    if (IS_ERR_OR_NULL(btf)) {
+        pr_err("BTF: vmlinux metadata unavailable (%ld)\n", btf ? PTR_ERR(btf) : -ENOENT);
+        return btf ? PTR_ERR(btf) : -ENOENT;
+    }
+
+    pr_info("BTF: looking up struct %s\n", structure);
+    id = btf_find_by_name_kind(btf, structure, BTF_KIND_STRUCT);
+    if (id < 0)
+        return id;
+    type = btf_type_by_id(btf, id);
+    if (!type)
+        return -EINVAL;
+
+    for_each_member (i, type, m) {
+        const struct btf_type *member_type;
+        const char *name = btf_name_by_offset(btf, m->name_off);
+        u32 bits, bytes, bitfield_size;
+
+        if (!name)
+            return -EINVAL;
+        if (strcmp(name, member))
+            continue;
+        bits = m->offset;
+        bitfield_size = 0;
+        if (BTF_INFO_KFLAG(type->info)) {
+            bitfield_size = BTF_MEMBER_BITFIELD_SIZE(bits);
+            bits = BTF_MEMBER_BIT_OFFSET(bits);
+        }
+        bytes = bits / 8;
+        if (bitfield_size || !size || (bits & 7) || bytes % size || bytes > type->size || size > type->size - bytes)
+            return -EINVAL;
+        member_type = btf_type_skip_modifiers(btf, m->type, NULL);
+        if (!member_type || BTF_INFO_KIND(member_type->info) != kind)
+            return -EINVAL;
+        if (kind == BTF_KIND_INT) {
+            u32 info = *(const u32 *)(member_type + 1);
+
+            if (member_type->size != size || BTF_INT_OFFSET(info) || BTF_INT_BITS(info) != size * 8 ||
+                (BTF_INT_ENCODING(info) & (BTF_INT_CHAR | BTF_INT_BOOL)))
+                return -EINVAL;
+        } else if (kind != BTF_KIND_PTR || size != sizeof(void *)) {
+            return -EINVAL;
+        }
+        field->offset = bytes;
+        field->struct_size = type->size;
+        pr_info("BTF: resolved %s.%s at %u, struct size %u\n", structure, member, bytes, type->size);
+        return 0;
+    }
+    return -ENOENT;
+}
+#endif

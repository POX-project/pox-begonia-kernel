diff --git a/drivers/finasu/hook/syscall_event_bridge.c b/drivers/finasu/hook/syscall_event_bridge.c
new file mode 100644
index 000000000000..54ad11aff0cc
--- /dev/null
+++ b/drivers/finasu/hook/syscall_event_bridge.c
@@ -0,0 +1,146 @@
+#include "linux/compiler.h"
